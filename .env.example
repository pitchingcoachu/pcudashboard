DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
DEMO_REQUEST_TO_EMAIL=info@pitchingcoachu.com
DEMO_REQUEST_FROM_EMAIL=onboarding@resend.dev
GOOGLE_SHEETS_WEBHOOK_URL=

AUTH_SECRET=replace_with_a_long_random_secret
# Preferred: JSON array for multiple users + assigned apps
APP_USERS_JSON=[{"email":"coach1@example.com","password":"change-me","appUrl":"https://your-shiny-app-url","name":"Coach One"}]
# Multi-app format example:
# APP_USERS_JSON=[{"email":"admin@example.com","password":"change-me","name":"Admin User","apps":[{"name":"GCU","url":"https://example.shinyapps.io/gcu/"},{"name":"LSU","url":"https://example.shinyapps.io/lsu/"},{"name":"ASU","url":"https://example.shinyapps.io/asu/"}]}]
# Optional fallback single-user fields:
AUTH_LOGIN_EMAIL=
AUTH_LOGIN_PASSWORD=
AUTH_APP_URL=
AUTH_LOGIN_NAME=
# Optional: set to enable sharing session cookies across subdomains (example: pcudashboard.com)
AUTH_COOKIE_DOMAIN=

# Python dashboard API integration (Shiny replacement pilot)
DASHBOARD_API_BASE_URL=http://127.0.0.1:8001
DASHBOARD_DATABASE_URL=
DASHBOARD_DEFAULT_SCHOOL_CODE=OSU
# Optional org->school mapping JSON (example: {"1":"OSU","2":"GCU"})
DASHBOARD_ORG_SCHOOL_MAP={"1":"PCU","2":"OSU","5":"CNU","6":"GCU","7":"LSU","8":"SEMO","9":"PRO","11":"CBU","12":"HARVARD","13":"UNM","14":"CREIGHTON","15":"GMU","16":"LEAGUE"}
# Optional comma-separated global admin emails with all-school access
GLOBAL_ADMIN_EMAILS=jgaynor@pitchingcoachu.com,ahalverson@pitchingcoachu.com,jchipman@pitchingcoachu.com

# VALD ForceDecks integration
# Region: use (US East), aue (Australia East), euw (Europe West)
VALD_REGION=use
VALD_TOKEN_URL=https://auth.prd.vald.com/oauth/token
VALD_AUDIENCE=vald-api-external
VALD_PROFILES_BASE_URL=
VALD_FORCEDECKS_BASE_URL=
VALD_CLIENT_ID=
VALD_CLIENT_SECRET=
# Tenant/team identifier used by ForceDecks test endpoints
VALD_FORCEDECKS_TENANT_ID=
# Optional lookback window for tests endpoint
VALD_LOOKBACK_DAYS=180

# Anthropic Claude API — Coaching Assistant chat agent
ANTHROPIC_API_KEY=

# Cloudflare R2 — raw biomechanics CSV archival
# Create a bucket at dash.cloudflare.com > R2, then generate an API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pcu
